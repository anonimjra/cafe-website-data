{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CafeDesignTokensDataset",
  "type": "object",
  "required": ["version", "themes", "typography_presets"],
  "properties": {
    "version": { "type": "string" },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "vibe", "colors"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "vibe": { "type": "string" },
          "colors": {
            "type": "object",
            "required": ["primary", "secondary", "background", "surface", "text", "muted", "accent"],
            "properties": {
              "primary": { "type": "string" },
              "secondary": { "type": "string" },
              "background": { "type": "string" },
              "surface": { "type": "string" },
              "text": { "type": "string" },
              "muted": { "type": "string" },
              "accent": { "type": "string" }
            }
          }
        }
      }
    },
    "typography_presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "heading_font", "body_font", "style_description"],
        "properties": {
          "id": { "type": "string" },
          "heading_font": { "type": "string" },
          "body_font": { "type": "string" },
          "style_description": { "type": "string" },
          "google_fonts_url": { "type": "string" }
        }
      }
    }
  }
}
