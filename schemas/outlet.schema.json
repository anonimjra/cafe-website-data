{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CafeOutletDataset",
  "type": "object",
  "required": ["version", "outlets"],
  "properties": {
    "version": { "type": "string" },
    "outlets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "city",
          "address",
          "coordinates",
          "google_maps_url",
          "operating_hours",
          "wfc_amenities",
          "ambient_soundscape",
          "reservation_policy",
          "contacts",
          "seo_structured_data"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tagline": { "type": "string" },
          "city": { "type": "string" },
          "address": { "type": "string" },
          "postal_code": { "type": "string" },
          "image_url": { "type": "string", "format": "uri" },
          "coordinates": {
            "type": "object",
            "required": ["latitude", "longitude"],
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" }
            }
          },
          "google_maps_url": { "type": "string", "format": "uri" },
          "operating_hours": {
            "type": "object",
            "required": ["weekday", "weekend"],
            "properties": {
              "weekday": { "type": "string" },
              "weekend": { "type": "string" },
              "peak_hours": { "type": "string" }
            }
          },
          "wfc_amenities": {
            "type": "object",
            "required": ["wifi_speed_mbps", "power_sockets_rating", "total_capacity", "prayer_room"],
            "properties": {
              "wifi_speed_mbps": { "type": "integer" },
              "power_sockets_rating": { "type": "string" },
              "total_capacity": { "type": "integer" },
              "has_meeting_room": { "type": "boolean" },
              "has_outdoor_smoking": { "type": "boolean" },
              "has_indoor_smoking": { "type": "boolean" },
              "prayer_room": {
                "type": "object",
                "properties": {
                  "available": { "type": "boolean" },
                  "details": { "type": "string" }
                }
              },
              "parking": {
                "type": "object",
                "properties": {
                  "car_spaces": { "type": "string" },
                  "motorcycle_spaces": { "type": "string" },
                  "valet_service": { "type": "boolean" }
                }
              }
            }
          },
          "ambient_soundscape": {
            "type": "object",
            "required": ["playlist_name", "spotify_playlist_url"],
            "properties": {
              "playlist_name": { "type": "string" },
              "spotify_playlist_url": { "type": "string", "format": "uri" },
              "spotify_embed_uri": { "type": "string" },
              "genre_vibe": { "type": "string" }
            }
          },
          "reservation_policy": {
            "type": "object",
            "required": ["allows_reservation"],
            "properties": {
              "allows_reservation": { "type": "boolean" },
              "minimum_spend_idr": { "type": "integer" },
              "max_duration_hours": { "type": "number" },
              "max_capacity_pax": { "type": "integer" },
              "terms": { "type": "string" },
              "deposit_percentage": { "type": "integer" }
            }
          },
          "contacts": {
            "type": "object",
            "required": ["whatsapp_order_number"],
            "properties": {
              "whatsapp_order_number": { "type": "string" },
              "instagram_handle": { "type": "string" },
              "delivery_links": {
                "type": "object",
                "properties": {
                  "gofood": { "type": "string" },
                  "grabfood": { "type": "string" }
                }
              }
            }
          },
          "seo_structured_data": {
            "type": "object",
            "required": ["@context", "@type", "name", "priceRange", "servesCuisine"],
            "properties": {
              "@context": { "type": "string" },
              "@type": { "type": "string" },
              "name": { "type": "string" },
              "image": { "type": "string" },
              "telephone": { "type": "string" },
              "priceRange": { "type": "string" },
              "servesCuisine": { "type": "string" },
              "acceptsReservations": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
